{
  "name": "mosaic-genlayer",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "genlayer": "npx --no-install genlayer",
    "genlayer:version": "npx --no-install genlayer --version",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
      "frontend:test": "npm --prefix frontend run test",
      "frontend:mutation": "npm --prefix frontend run mutation",
    "frontend:typecheck": "npx --prefix frontend tsc -p frontend/tsconfig.json --noEmit",
    "contract:test": "python -m pytest contract/tests/direct -q",
    "contract:mutation": "python contract/tests/mutation/run.py",
    "contract:lint": "genvm-lint check contract/contracts/mosaic.py",
    "check:network": "node scripts/check-network.mjs",
    "check:architecture": "node scripts/audit-architecture.mjs",
    "check:cli": "node scripts/check-cli-version.mjs",
    "check:integrity": "node scripts/check-integrity.mjs",
    "check:comparators": "node scripts/check-comparators.mjs",
    "check:release-smoke": "node scripts/release-smoke.mjs",
    "check:public-evidence": "node scripts/public-evidence-integration.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:release": "node scripts/check-release-consistency.mjs",
    "check": "npm run check:network && npm run check:architecture && npm run check:cli && npm run check:integrity && npm run check:comparators && npm run contract:lint && npm run contract:test && npm run frontend:lint && npm run frontend:test && npm run frontend:build"
  },
  "devDependencies": {
    "genlayer": "0.39.1"
  },
  "engines": {
    "node": ">=20"
  }
}
